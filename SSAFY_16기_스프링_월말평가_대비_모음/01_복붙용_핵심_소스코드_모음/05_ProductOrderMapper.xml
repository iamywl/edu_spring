<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
  ============================================================================
  [Mapper XML = 실제 SQL 쿼리문을 적어두는 파일]
  위치: src/main/resources/mappers/ProductOrderMapper.xml

  ★★★ 절대 규칙 3가지 ★★★
  1. namespace="..." 안에는 연결할 DAO 인터페이스의 [패키지명.클래스명] 전체를 적습니다.
     (오타 나면 무조건 Invalid bound statement 에러 발생!)
  2. 각 태그의 id="..." 는 DAO 인터페이스에 적은 메서드 이름과 똑같아야 합니다.
  3. XML 안에서는 부등호 '<', '<=' 를 그대로 쓰면 태그로 오해해서 에러가 납니다!
     반드시  > 는 &gt;   /   >= 는 &gt;=   /   < 는 &lt;   /   <= 는 &lt;= 로 적으세요!
  ============================================================================
-->
<mapper namespace="com.ssafy.sample.model.dao.ProductOrderDao">

    <!-- [resultMap] DB 컬럼(column) 이름과 자바 DTO 변수(property) 이름이 다를 때 연결표 -->
    <resultMap type="OrderDto" id="Order">
        <id column="order_id" property="orderId" />
        <result column="product_id" property="productId" />
        <result column="user_id" property="userId" />
        <result column="order_date" property="orderDate" />
        <result column="quantity" property="quantity" />
        <result column="status" property="status" />
        <result column="product_name" property="productName" />
    </resultMap>

    <resultMap type="ProductDto" id="Product">
        <id column="product_id" property="productId" />
        <result column="name" property="name" />
        <result column="price" property="price" />
        <result column="stock" property="stock" />
        <result column="last_customer_name" property="lastCustomerName" />
    </resultMap>

    <!-- 1. 전체 상품 목록 조회 -->
    <select id="getProductList" resultMap="Product">
        SELECT *
        FROM products
    </select>

    <!-- 2. 주문 상세 조회 (products 테이블과 JOIN해서 product_name까지 함께 가져오기) -->
    <select id="getOrderDetail" resultMap="Order">
        SELECT o.*, p.name AS product_name
        FROM orders o
        LEFT JOIN products p ON o.product_id = p.product_id
        WHERE o.order_id = #{orderId}
    </select>

    <!-- 3. 주문 취소 (이미 취소된 건 제외하고 CANCELLED로 변경) -->
    <update id="cancelOrder">
        UPDATE orders
        SET status = 'CANCELLED'
        WHERE order_id = #{orderId}
          AND status != 'CANCELLED'
    </update>

    <!-- 4. 주문 추가 (#{productId} 는 OrderDto의 getProductId() 값을 꺼내서 넣어줌) -->
    <!-- useGeneratedKeys="true" keyProperty="orderId" : DB가 자동 생성한 order_id를 dto에 다시 채워줌 -->
    <insert id="insertOrder" parameterType="OrderDto" useGeneratedKeys="true" keyProperty="orderId">
        INSERT INTO orders (product_id, user_id, quantity)
        VALUES (#{productId}, #{userId}, #{quantity})
    </insert>

    <!-- 5. 주문 삭제 -->
    <delete id="deleteOrder">
        DELETE FROM orders
        WHERE order_id = #{orderId}
    </delete>

    <!-- 6. 동적 조건 검색 + 최근 구매자 1명 서브쿼리 -->
    <!-- resultType: application.properties에 map-underscore-to-camel-case=true 가 있어야 자동 매핑! -->
    <select id="searchProduct" resultType="com.ssafy.sample.model.dto.SearchResponse">
        SELECT
            p.product_id,
            p.name,
            p.price,
            p.stock,
            <!-- 상관 서브쿼리: 해당 상품(p.product_id)을 완료(COMPLETED) 주문한 가장 최근 사용자 실명 1명 -->
            (SELECT u.user_name
             FROM orders o
             JOIN users u ON o.user_id = u.user_id
             WHERE o.product_id = p.product_id
               AND o.status = 'COMPLETED'
             ORDER BY o.order_date DESC, o.order_id DESC
             LIMIT 1) AS last_customer_name
        FROM products p
        <!-- <where> 태그는 조건이 1개 이상 참일 때만 WHERE을 붙이고 맨 앞 AND를 알아서 지워줍니다 -->
        <where>
            <!-- 문자열 조건은 null 체크 + 빈 문자열('') 체크 둘 다 하는 것이 안전 -->
            <if test="name != null and name != ''">
                AND p.name LIKE CONCAT('%', #{name}, '%')
            </if>
            <!-- 숫자 조건: >= 는 &gt;= 로 적어야 XML 파싱 에러가 안 남! -->
            <if test="minPrice != null">
                AND p.price &gt;= #{minPrice}
            </if>
            <!-- 숫자 조건: <= 는 &lt;= 로 적어야 XML 파싱 에러가 안 남! -->
            <if test="maxPrice != null">
                AND p.price &lt;= #{maxPrice}
            </if>
        </where>
    </select>

    <!-- =========================================================================
         [심화 대비] 재고/포인트 차감 및 취소 시 재고 복구 쿼리 (DAO와 짝 맞춤)
         ========================================================================= -->
    <select id="getProductById" resultMap="Product">
        SELECT * FROM products WHERE product_id = #{productId}
    </select>

    <update id="decreaseStock">
        UPDATE products
        SET stock = stock - #{quantity}
        WHERE product_id = #{productId}
          AND stock &gt;= #{quantity}
    </update>

    <update id="increaseStock">
        UPDATE products
        SET stock = stock + #{quantity}
        WHERE product_id = #{productId}
    </update>

    <update id="decreasePoint">
        UPDATE users
        SET point = point - #{amount}
        WHERE user_id = #{userId}
          AND point &gt;= #{amount}
    </update>

</mapper>
